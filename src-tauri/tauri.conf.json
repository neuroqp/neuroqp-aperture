{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aperture",
  "version": "0.1.0",
  "identifier": "com.neuroqp.aperture",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Aperture",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 400,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' aperture: http://aperture.localhost blob: data:; connect-src 'self' ipc: http://ipc.localhost aperture: http://aperture.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "targets": ["appimage"],
    "createUpdaterArtifacts": true,
    "publisher": "NeuroQP",
    "category": "Education",
    "shortDescription": "A microscopy image viewer",
    "longDescription": "View large microscopy images and edit ImageJ-compatible point annotations."
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhFMTIxNjU5OUU4OEQ2NEYKUldSUDFvaWVXUllTam1PTnFod2o4Q0FlS0N1TkNXVGJIZ3lSQ1d0L1B6Y0pRTHc5VW9ZNDJnbGsK",
      "endpoints": [
        "https://github.com/neuroqp/neuroqp-aperture/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
