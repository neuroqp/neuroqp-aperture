{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aperture",
  "version": "0.1.0",
  "identifier": "com.neuroqp.aperture",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Aperture",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 400,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' aperture: http://aperture.localhost blob: data:; connect-src 'self' ipc: http://ipc.localhost aperture: http://aperture.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png"] }
}
